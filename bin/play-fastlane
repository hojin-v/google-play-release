#!/usr/bin/env bash
# Run with system Bundler or the persistent local Ruby runtime used for this release.
set -euo pipefail
TOOL_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PROJECT_ROOT="${PLAY_PROJECT_ROOT:-$PWD}"
if [[ "${1:-}" == '--project' ]]; then
  PROJECT_ROOT="${2:?provide the Android project directory}"
  shift 2
fi
export PLAY_PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd)"
test -f "$PLAY_PROJECT_ROOT/play/release.json"
cd "$TOOL_ROOT"
export FASTLANE_SKIP_UPDATE_CHECK=1
COMMAND=(fastlane "$@")
if [[ "${1:-}" == '--test-client' ]]; then
  COMMAND=(ruby fastlane/test_play_client.rb)
fi

if command -v bundle >/dev/null 2>&1 && command -v ruby >/dev/null 2>&1; then
  exec bundle exec "${COMMAND[@]}"
fi

RUNTIME="${PLAY_RUBY_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/play-release/ruby}"
if [[ ! -x "$RUNTIME/root/usr/bin/ruby3.2" || ! -f "$RUNTIME/root/usr/bin/bundle" || ! -d "$RUNTIME/gems" ]]; then
  echo 'Install Ruby/Bundler and run bundle install, or set PLAY_RUBY_ROOT to the local runtime.' >&2
  exit 1
fi

export LD_LIBRARY_PATH="$RUNTIME/root/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export RUBYLIB="$RUNTIME/root/usr/lib/ruby/3.2.0:$RUNTIME/root/usr/lib/x86_64-linux-gnu/ruby/3.2.0:$RUNTIME/root/usr/lib/ruby/vendor_ruby${RUBYLIB:+:$RUBYLIB}"
export PATH="$RUNTIME/root/usr/bin:$PATH"
export GEM_HOME="$RUNTIME/gems"
export GEM_PATH="$RUNTIME/gems:$RUNTIME/root/usr/lib/ruby/gems/3.2.0"
exec "$RUNTIME/root/usr/bin/ruby3.2" "$RUNTIME/root/usr/bin/bundle" exec "${COMMAND[@]}"
